{
  "schema": 1,
  "git": { "main": "main", "remote": "origin", "github": "andornaut/archies-dog-walks" },
  "schedule": { "departures": ["10"], "timezone": "America/Toronto" },
  "gate": {
    "image": "sha256:f42d09d4b8aabd27ce3f8b82adf0534c4e0f37769d9f0e595869b911b7c2a9a8",
    "install": "npm ci",
    "steps": [
      { "name": "lint", "run": "tests/container/check lint" },
      { "name": "test", "run": "tests/container/check test" },
      { "name": "build", "run": "tests/container/check build" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 30 },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "project": "Archie",
    "scheduledTicks": true,
    "recipient": "dev-manager",
    "workerParents": ["dev-manager"]
  }
}
