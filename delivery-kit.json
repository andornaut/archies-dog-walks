{
  "schema": 1,
  "git": { "main": "main", "remote": "origin", "github": "andornaut/archies-dog-walks" },
  "schedule": { "departures": ["10"], "timezone": "America/Toronto" },
  "gate": {
    "image": "archie-check:node24.21.0-sox-ffmpeg",
    "install": "npm ci",
    "steps": [
      { "name": "check", "run": "npm run check" },
      { "name": "lint", "run": "npm run lint" },
      { "name": "test", "run": "npm test" },
      { "name": "build", "run": "npm run build" },
      { "name": "art", "run": "node art/tools/build.ts --check" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 24 },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "project": "Archie",
    "scheduledTicks": true,
    "recipient": "dev-manager",
    "workerParents": ["dev-manager"]
  }
}
