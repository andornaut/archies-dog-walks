{
  "schema": 1,
  "git": { "main": "main", "remote": "origin", "github": "andornaut/archies-dog-walks" },
  "schedule": { "departures": ["10"], "timezone": "America/Toronto" },
  "gate": {
    "image": "sha256:578e112393a279ba4ab9943946713f675ef7227e05ec42f6f77cedfa9022ebaa",
    "install": "npm ci",
    "steps": [
      { "name": "lint", "run": "tests/container/check lint" },
      { "name": "test", "run": "tests/container/check test" },
      { "name": "build", "run": "tests/container/check build" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 30, "memoryMiB": 4096 },
  "ci": {
    "requiredNames": ["AI attributions", "Changes", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "scheduledTicks": true,
    "recipient": "game-coordinator",
    "workerParents": ["game-coordinator"]
  }
}
