{
  "name": "archies-dog-walks",
  "version": "0.0.1",
  "description": "A cozy pixel-art lane runner about walking dogs.",
  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "./tests/container/check bundle",
    "preview": "npm run build && wrangler dev",
    "check": "./tests/container/check typecheck",
    "lint": "./tests/container/check lint-only",
    "format": "prettier --write . && eslint --fix .",
    "test": "./tests/container/check test",
    "test:game-kit": "vitest run --configLoader runner --no-cache --no-fsModuleCache src/assets/phaser/manifestArt.test.ts src/home/modalLayout.test.ts src/pwa/installNudge.test.ts",
    "check:art": "vitest run src/assets/ src/scenes/artCoverage.test.ts src/tools/artManifest.test.ts src/tools/atlas/",
    "art:unused": "node src/assets/unusedArtCli.ts",
    "simulate": "node src/sim/cli.ts",
    "planner:acceptance": "node src/tools/plannerAcceptance/cli.ts",
    "export:data": "node src/tools/dataExportCli.ts",
    "art:manifest": "node src/tools/artManifestCli.ts",
    "art:depth-preview": "node src/tools/depthPreviewCli.ts",
    "clean": "rm -rf dist .wrangler",
    "art:build": "node art/tools/build.ts"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.19.0/game-kit-0.19.0.tgz",
    "phaser": "^4.2.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.22.0/art-kit-0.22.0.tgz",
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v2.1.1/delivery-kit-2.1.1.tgz",
    "@eslint/js": "^10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "skia-canvas": "4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import-x": {
      "minimatch": "11.0.3"
    },
    "markdown-it": "15.0.3",
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
